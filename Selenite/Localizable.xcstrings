    "%@ is running on %@. Starting %@ quits it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ běží na %2$@. Spuštěním %3$@ to vypneš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kører på %2$@. Starter du %3$@, bliver det afsluttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ läuft auf %2$@. Wenn du %3$@ startest, wird es beendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %1$@ εκτελείται στο %2$@. Η εκκίνηση του %3$@ θα το κλείσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se está ejecutando en %@. Iniciar %@ lo cierra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ on käynnissä %2$@:ssä. %3$@:n käynnistäminen sulkee sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tourne sur %@. Lancer %@ l'arrête."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igra %1$@ je pokrenuta na %2$@. Pokretanjem %3$@ ta igra se zatvara."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fut a %2$@ gépen. A %3$@ elindítása ezt bezárja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione su %@. L'avvio di %@ lo chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ で %1$@ が実行中です。%3$@ を起動すると終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 호스트에서 %1$@ 앱이 실행 중입니다. %3$@ 앱을 시작하면 종료됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kjører på %2$@. Starter du %3$@, blir det avsluttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ draait op %@. Als je %@ start, wordt het afgesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ jest uruchomione na %2$@. Uruchomienie %3$@ to zamknie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está em execução em %2$@. Iniciar %3$@ vai encerrá-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está em execução em %2$@. Iniciar %3$@ vai encerrá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ este în execuție pe %2$@. Pornirea %3$@ îl va închide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ уже запущена на %2$@. Если вы запустите %3$@, игра закроется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je spustené na %2$@. Spustením %3$@ to vypneš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ körs på %2$@. Om du startar %3$@ avslutas det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ üzerinde çalışıyor. %3$@ başlatılırsa bu oyun kapanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ вже запущена на %2$@. Якщо ви запустите %3$@, вона закриється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 上正在运行 %1$@。启动 %3$@ 会关闭它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 上正在執行 %1$@。啟動 %3$@ 會關閉它。"

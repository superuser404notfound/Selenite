    "No video arrived from the host. A firewall may be blocking UDP port 47998." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z hostitele nepřišel žádný obraz. Firewall možná blokuje UDP port 47998."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kom intet billede fra værten. En firewall blokerer muligvis UDP-port 47998."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Host kam kein Bild an. Eventuell blockiert eine Firewall den UDP-Port 47998."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έφτασε εικόνα από τον host. Ένα firewall μπορεί να μπλοκάρει τη θύρα UDP 47998."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ha llegado vídeo desde el host. Puede que un firewall esté bloqueando el puerto UDP 47998."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isännältä ei saapunut kuvaa. Palomuuri saattaa estää UDP-portin 47998."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune vidéo reçue de l'hôte. Un pare-feu bloque peut-être le port UDP 47998."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video s hosta nije stigao. Moguće je da firewall blokira UDP port 47998."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem érkezett kép a hosttól. Tűzfal blokkolhatja a 47998-as UDP portot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è arrivato alcun video dall'host. Un firewall potrebbe bloccare la porta UDP 47998."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストから映像が届きませんでした。ファイアウォールがUDPポート47998をブロックしている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트에서 영상이 도착하지 않았습니다. 방화벽이 UDP 포트 47998을 차단하고 있을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kom ikke noe bilde fra verten. En brannmur blokkerer muligens UDP-port 47998."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen video van de host ontvangen. Mogelijk blokkeert een firewall UDP-poort 47998."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z hosta nie nadszedł żaden obraz. Zapora sieciowa może blokować port UDP 47998."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

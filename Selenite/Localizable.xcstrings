    "In split screen only the codec applies; the bitrate there is half the global one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V rozdělené obrazovce platí jen codec; datový tok je tam poloviční oproti globálnímu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I splitscreen gælder kun codec; bitraten er der halvdelen af den globale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Splitscreen gilt nur der Codec; die Bitrate ist dort die Hälfte der globalen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στον διαχωρισμό οθόνης εφαρμόζεται μόνο η κωδικοποίηση· ο ρυθμός bit εκεί είναι ο μισός του καθολικού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pantalla dividida solo se aplica el códec; la tasa de bits allí es la mitad de la global."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaetussa näytössä vain Codec vaikuttaa; bittinopeus on siinä puolet yleisestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En écran partagé, seul le codec s'applique ; le débit y est la moitié du débit global."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U splitu vrijedi samo codec, a bitrate je tamo polovica globalnog."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osztott képernyőn csak a codec érvényes; a bitráta ott a globális fele."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nello schermo diviso si applica solo il codec; il bitrate lì è la metà di quello globale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面分割ではコーデックのみが適用され、ビットレートはグローバル設定の半分になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 분할에서는 코덱만 적용되며, 비트레이트는 전역 설정의 절반입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I splitscreen gjelder bare kodek; bitraten er der halvparten av den globale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij gesplitst scherm geldt alleen de codec; de bitsnelheid is daar de helft van de algemene."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trybie podzielonego ekranu obowiązuje tylko kodek; przepływność jest tam równa połowie globalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tela dividida, só o codec se aplica; a taxa de bits lá é metade da global."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ecrã dividido, só o codec se aplica; a taxa de bits aí é metade da global."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În ecranul împărțit se aplică doar codecul; rata de biți este acolo jumătate din cea globală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В сплитскрине действует только кодек, битрейт при этом равен половине общего."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V rozdelenej obrazovke platí len codec; dátový tok je tam polovičný oproti globálnemu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I splitscreen gäller bara codec; bitraten är där hälften av den globala."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölünmüş ekranda yalnızca kodek geçerlidir; bit oranı burada genel değerin yarısıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У спліті діє лише кодек, бітрейт там дорівнює половині загального."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在分割画面中只应用编码设置，比特率为全局设置的一半。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在分割畫面中只會套用編解碼器設定，位元率則為全域設定的一半。"
          }
        }
      }
    },

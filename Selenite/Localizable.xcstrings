    "Selenite continues as soon as the PC answers." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selenite bude pokračovat, jakmile počítač odpoví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selenite fortsætter, så snart pc'en svarer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selenite macht weiter, sobald der PC antwortet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Selenite συνεχίζει μόλις απαντήσει ο PC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selenite continúa en cuanto el PC responda."
          }
        },

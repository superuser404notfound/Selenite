    "Free software under the GNU GPLv3. Streaming is built on moonlight-common-c by the Moonlight Game Streaming Project, also GPLv3." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svobodný software pod licencí GNU GPLv3. Streaming je postaven na moonlight-common-c od Moonlight Game Streaming Project, rovněž pod GPLv3."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fri software under GNU GPLv3. Streaming er bygget på moonlight-common-c fra Moonlight Game Streaming Project, også GPLv3."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freie Software unter der GNU GPLv3. Das Streaming basiert auf moonlight-common-c vom Moonlight Game Streaming Project, ebenfalls GPLv3."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελεύθερο λογισμικό υπό την άδεια GNU GPLv3. Το streaming βασίζεται στο moonlight-common-c από το Moonlight Game Streaming Project, επίσης υπό GPLv3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Software libre bajo la GNU GPLv3. El streaming se basa en moonlight-common-c, del Moonlight Game Streaming Project, también GPLv3."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen ohjelmisto GNU GPLv3 -lisenssillä. Striimaus perustuu Moonlight Game Streaming Projectin moonlight-common-c-kirjastoon, joka on myös GPLv3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

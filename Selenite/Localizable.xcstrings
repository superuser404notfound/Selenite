    "Another game is running on %@. Starting %@ quits it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na %1$@ běží jiná hra. Spuštěním %2$@ ji vypneš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et andet spil kører på %1$@. Starter du %2$@, bliver det afsluttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %1$@ läuft ein anderes Spiel. Wenn du %2$@ startest, wird es beendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα άλλο παιχνίδι εκτελείται στο %1$@. Η εκκίνηση του %2$@ θα το κλείσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay otro juego en ejecución en %@. Iniciar %@ lo cierra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@:ssä on käynnissä toinen peli. %2$@:n käynnistäminen sulkee sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre jeu est en cours sur %@. Lancer %@ l'arrête."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na %1$@ je već pokrenuta druga igra. Pokretanjem %2$@ ona se zatvara."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy másik játék fut a %1$@ gépen. A %2$@ elindítása bezárja azt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro gioco è in esecuzione su %@. L'avvio di %@ lo chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ で別のゲームが実行中です。%2$@ を起動すると終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 호스트에서 다른 게임이 실행 중입니다. %2$@ 앱을 시작하면 종료됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et annet spill kjører på %1$@. Starter du %2$@, blir det avsluttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er draait al een ander spel op %@. Als je %@ start, wordt het afgesloten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na %1$@ jest uruchomiona inna gra. Uruchomienie %2$@ ją zamknie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro jogo está em execução em %1$@. Iniciar %2$@ vai encerrá-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro jogo está em execução em %1$@. Iniciar %2$@ vai encerrá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un alt joc este în execuție pe %1$@. Pornirea %2$@ îl va închide."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На %1$@ уже запущена другая игра. Если вы запустите %2$@, она закроется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na %1$@ je spustená iná hra. Spustením %2$@ ju vypneš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett annat spel körs på %1$@. Om du startar %2$@ avslutas det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ üzerinde başka bir oyun çalışıyor. %2$@ başlatılırsa o kapanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На %1$@ вже запущена інша гра. Якщо ви запустите %2$@, вона закриється."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 上正在运行另一个游戏。启动 %2$@ 会关闭它。"

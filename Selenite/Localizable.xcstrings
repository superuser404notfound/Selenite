    "Pairing timed out. Enter the PIN in Sunshine's web UI within two minutes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časový limit párování vypršel. Zadej PIN ve webovém rozhraní Sunshine do dvou minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsudløb ved parring. Indtast PIN'en i Sunshines webgrænseflade inden for to minutter."

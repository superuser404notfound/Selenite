    "%@ did not wake up. Check that Wake-on-LAN is enabled on the PC." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se neprobudil. Zkontroluj, zda je v počítači zapnuté Wake-on-LAN."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vågnede ikke op. Kontrollér, at Wake-on-LAN er aktiveret på pc'en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht aufgewacht. Prüfe, ob Wake-on-LAN am PC aktiviert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ δεν ξύπνησε. Ελέγξτε αν το Wake-on-LAN είναι ενεργοποιημένο στον PC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se ha despertado. Comprueba que Wake-on-LAN esté activado en el PC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ei herännyt. Tarkista, että Wake-on-LAN on käytössä PC:ssä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne s'est pas réveillé. Vérifiez que Wake-on-LAN est activé sur le PC."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije bilo moguće probuditi %@. Provjeri je li Wake-on-LAN uključen na računalu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nem ébredt fel. Ellenőrizd, hogy a Wake-on-LAN be van-e kapcsolva a gépen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non si è svegliato. Controlla che Wake-on-LAN sia attivo sul PC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が起動しませんでした。PCでWake-on-LANが有効になっているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 호스트가 켜지지 않았습니다. PC에서 Wake-on-LAN이 켜져 있는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ våknet ikke. Kontroller at Wake-on-LAN er aktivert på pc-en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is niet wakker geworden. Controleer of Wake-on-LAN op de pc is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie obudził się. Sprawdź, czy na komputerze jest włączone Wake-on-LAN."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não despertou. Verifique se o Wake-on-LAN está ativado no PC."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não despertou. Verifica se o Wake-on-LAN está ativado no PC."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nu s-a trezit. Verifică dacă Wake-on-LAN este activat pe PC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось разбудить %@. Проверьте, включена ли Wake-on-LAN на ПК."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sa nezobudil. Skontroluj, či je v počítači zapnuté Wake-on-LAN."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",

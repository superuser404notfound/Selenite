          "stringUnit" : {
            "state" : "translated",
            "value" : "Selenite nastavlja čim računalo odgovori."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Selenite folytatja, amint a gép válaszol."

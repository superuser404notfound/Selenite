    "Sunshine is already pairing with another device. Finish or cancel that first." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine už páruje s jiným zařízením. Nejdřív to dokonči, nebo to zruš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine parrer allerede med en anden enhed. Afslut eller annullér det først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine koppelt gerade mit einem anderen Gerät. Schließe das zuerst ab oder brich es ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sunshine βρίσκεται ήδη σε σύζευξη με άλλη συσκευή. Ολοκληρώστε ή ακυρώστε πρώτα αυτή τη διαδικασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine ya se está vinculando con otro dispositivo. Termina o cancela eso primero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine pariutuu jo toisen laitteen kanssa. Lopeta tai peruuta se ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine est déjà en cours d'association avec un autre appareil. Terminez ou annulez d'abord cette opération."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine je već u postupku uparivanja s drugim uređajem. Prvo to završi ili otkaži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sunshine már egy másik eszközzel párosodik. Előbb fejezd be, vagy szakítsd meg azt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine è già in fase di associazione con un altro dispositivo. Completa o annulla prima quell'operazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshineは別のデバイスとペアリング中です。先にそれを完了またはキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine가 다른 기기와 페어링 중입니다. 먼저 완료하거나 취소하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine parrer allerede med en annen enhet. Fullfør eller avbryt det først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine is al aan het koppelen met een ander apparaat. Rond dat eerst af of annuleer het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine już paruje z innym urządzeniem. Najpierw dokończ to parowanie albo je anuluj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sunshine já está emparelhando com outro dispositivo. Conclua ou cancele isso primeiro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sunshine já está a emparelhar com outro dispositivo. Conclui ou cancela isso primeiro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine se împerechează deja cu alt dispozitiv. Finalizează sau anulează mai întâi acea operațiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine уже выполняет сопряжение с другим устройством. Сначала завершите или отмените его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine už páruje s iným zariadením. Najprv to dokonči alebo zruš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine parkopplar redan med en annan enhet. Slutför eller avbryt det först."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine zaten başka bir cihazla eşleşiyor. Önce bunu tamamla veya iptal et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine вже виконує парування з іншим пристроєм. Спочатку завершіть або скасуйте це."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine 正在与另一台设备配对。请先完成或取消该配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunshine 正在與另一台裝置配對。請先完成或取消該配對。"
          }
